{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://starstell.com/#organization",
      "name": "StarsTell",
      "url": "https://starstell.com/",
      "logo": "https://starstell.com/assets/images/logo.png",
      "sameAs": [
        "https://twitter.com/yourstarstell",
        "https://www.facebook.com/StarsTell",
        "https://www.youtube.com/channel/UCL6UlotMnqqTf4cfO0IZggg",
        "https://www.instagram.com/YourStarsTell/",
        "https://www.linkedin.com/company/happy-starstell-com-private-limited"
      ]
    },
    {
      "@type": "ProfilePage",
      "@id": "https://starstell.com/best-astrologer/{{slug}}#profilepage",
      "url": "https://starstell.com/best-astrologer/{{slug}}",
      "name": "{{name}} | Online Astrologer | StarsTell",
      "inLanguage": "en-IN",
      "isPartOf": { "@id": "https://starstell.com/#website" },
      "dateModified": "{{updated_at_iso8601}}",
      "mainEntity": { "@id": "https://starstell.com/best-astrologer/{{slug}}#person" },
      "breadcrumb": { "@id": "https://starstell.com/best-astrologer/{{slug}}#breadcrumb" }
    },
    {
      "@type": "Person",
      "@id": "https://starstell.com/best-astrologer/{{slug}}#person",
      "name": "{{name}}",
      "url": "https://starstell.com/best-astrologer/{{slug}}",
      "image": "{{photo_absolute_url}}",
      "description": "{{bio_first_160_chars}}",
      "jobTitle": "Astrologer",
      "knowsAbout": ["{{speciality_1}}", "{{speciality_2}}"],
      "knowsLanguage": ["{{language_1}}", "{{language_2}}"],
      "worksFor": { "@id": "https://starstell.com/#organization" }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://starstell.com/best-astrologer/{{slug}}#service",
      "name": "Online astrology consultation with {{name}}",
      "serviceType": "Astrology consultation",
      "provider": { "@id": "https://starstell.com/best-astrologer/{{slug}}#person" },
      "areaServed": { "@type": "Country", "name": "India" },
      "availableLanguage": ["{{language_1}}", "{{language_2}}"],
      "url": "https://starstell.com/best-astrologer/{{slug}}",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "{{price_per_minute}}",
          "priceCurrency": "INR",
          "unitCode": "MIN"
        },
        "availability": "https://schema.org/InStock",
        "url": "https://starstell.com/talk-to-astrologer"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{rating_value}}",
        "reviewCount": "{{rating_count}}",
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "{{reviewer_first_name}}" },
          "datePublished": "{{review_date_iso8601}}",
          "reviewRating": { "@type": "Rating", "ratingValue": "{{review_rating}}", "bestRating": "5" },
          "reviewBody": "{{review_text}}"
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://starstell.com/best-astrologer/{{slug}}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://starstell.com/" },
        { "@type": "ListItem", "position": 2, "name": "Talk to Astrologer", "item": "https://starstell.com/talk-to-astrologer" },
        { "@type": "ListItem", "position": 3, "name": "{{name}}", "item": "https://starstell.com/best-astrologer/{{slug}}" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://starstell.com/best-astrologer/{{slug}}#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How can I talk to {{name}}?",
          "acceptedAnswer": { "@type": "Answer", "text": "{{answer_visible_on_page}}" }
        }
      ]
    }
  ]
}
